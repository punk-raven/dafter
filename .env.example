# Dafter POC environment
#
# Copy to .env and fill in values. Only DAFTER_LIVEKIT_* are required
# for the control plane; the rest configure docker compose services.

# Control plane - matches deploy/livekit.yaml dev credentials
DAFTER_LIVEKIT_URL=ws://127.0.0.1:7880
DAFTER_LIVEKIT_API_KEY=devkey
DAFTER_LIVEKIT_API_SECRET=secret

# Agent worker (the `agent` compose service). The resolved config names the
# credential as secret://tenants/<tenant>/sarvam/api-key; the worker reads the
# value from SARVAM_API_KEY and nowhere else.
# SARVAM_API_KEY=your-sarvam-api-subscription-key
# The scribe (the `scribe` compose service) reads the same keys for the LLM its
# session names in scribe.llm and scribe.judge.

# OpenAI-compatible LLM endpoints (the openai_compat provider). A credential
# named secret://tenants/<tenant>/gemini/api-key is read from GEMINI_API_KEY;
# the last two path segments name the variable, so openrouter/api-key reads
# OPENROUTER_API_KEY and opencode/api-key reads OPENCODE_API_KEY. A stage names
# its endpoint, and reads only the one key openai_compat/endpoints.json binds
# to it.
# GEMINI_API_KEY=your-google-ai-studio-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENCODE_API_KEY=your-opencode-zen-api-key
# NVIDIA_API_KEY=your-build-nvidia-com-api-key
# The scribe's LLM is config: the catalog's default is Sarvam; the profiles
# scribe-gemini and scribe-nvidia switch its llm and judge to free models on the
# google and nvidia endpoints, and read GEMINI_API_KEY or NVIDIA_API_KEY.

# Phone calls over the Vobiz SIP trunk (the "vobiz" entry of
# go/cmd/dafter-control/trunks.json, the tenant's phone line in the catalog,
# used by telephony sessions and by meetings created with phoneGuests
# dial_out). Every value is per account and comes from the Vobiz Console.
# Leave all unset and the control plane runs without the trunk, refusing
# that tenant's telephony sessions and phone guests.
# Outbound: the trunk's SIP domain (host only, no sip: prefix), the account's
# numbers as comma separated E.164, and the trunk credential.
# VOBIZ_SIP_DOMAIN=your-trunk-id.sip.vobiz.ai
# VOBIZ_SIP_NUMBERS=+91XXXXXXXXXX
# VOBIZ_SIP_USERNAME=your-trunk-credential-username
# VOBIZ_SIP_PASSWORD=your-trunk-credential-password
# Inbound: the https address Vobiz reaches the control plane at, the account
# Auth Token that signs Vobiz webhooks, and the app id of the bridge
# application (public SIP URI on, answer URL: the webhook address followed by
# /telephony/vobiz/bridge). The number's own application answers at
# /telephony/vobiz/answer. Unsigned answers are refused, and Vobiz signs a
# webhook only when its URL has credentials configured in the Console.
# VOBIZ_SIP_WEBHOOK_URL=https://calls.yourdomain.com
# VOBIZ_SIP_AUTH_TOKEN=your-vobiz-auth-token
# VOBIZ_SIP_BRIDGE_APP=your-bridge-application-id

# Optional: Cloudflare TURN relay for firewall traversal testing.
# Get these from the Cloudflare dashboard under Real-Time Communications > TURN.
# When both are set, POST /sessions returns iceServers with short-lived credentials.
# DAFTER_TURN_TOKEN_ID=your-turn-token-id
# DAFTER_TURN_API_TOKEN=your-turn-api-token

# Optional: Cloudflare Tunnel for external access.
# Create a tunnel at dash.cloudflare.com > Zero Trust > Networks > Tunnels.
# Add two public hostname routes in the tunnel config:
#   dafter.yourdomain.com  -> http://control:8080
#   sfu.yourdomain.com     -> http://livekit:7880
# Also forward UDP port 7882 on your router for WebRTC media, and advertise
# the address that forwarding lands on (default 127.0.0.1, this machine only).
# The tunnel service is behind the compose profile "tunnel", so make dev
# starts it only when COMPOSE_PROFILES names it; without a token it would
# restart forever.
# COMPOSE_PROFILES=tunnel
# DAFTER_CF_TUNNEL_TOKEN=your-tunnel-token
# LIVEKIT_NODE_IP=your-public-ip
