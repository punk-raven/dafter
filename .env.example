# Dafter POC environment
#
# Copy to .env and fill in values. Only DAFTER_LIVEKIT_* are required
# for the control plane; the rest configure docker compose services.

# Control plane - matches deploy/livekit.yaml dev credentials
DAFTER_LIVEKIT_URL=ws://127.0.0.1:7880
DAFTER_LIVEKIT_API_KEY=devkey
DAFTER_LIVEKIT_API_SECRET=secret

# Optional: Cloudflare TURN relay for firewall traversal testing.
# Get these from the Cloudflare dashboard under Real-Time Communications > TURN.
# When both are set, POST /sessions returns iceServers with short-lived credentials.
# DAFTER_TURN_TOKEN_ID=your-turn-token-id
# DAFTER_TURN_API_TOKEN=your-turn-api-token
