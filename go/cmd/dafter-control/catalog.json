{
  "defaults": {
    "apiVersion": "dafter.dev/v1",
    "privacyMode": "open",
    "agent": {
      "enabled": true,
      "pool": "dafter-py",
      "name": "Nivya",
      "greets": false,
      "mode": "cascaded",
      "pipeline": {
        "vad": {
          "provider": "silero",
          "model": "silero",
          "options": { "minSpeechMs": 50, "minSilenceMs": 250, "prefixPaddingMs": 500, "activationThreshold": 0.5 }
        }
      },
      "addressing": {
        "mode": "transcript",
        "aliases": ["निव्या", "ನಿವ್ಯ", "ನಿವ್ಯಾ", "నివ్య", "నివ్యా"],
        "nearMisses": [
          "Navya", "Divya", "Kavya", "Bhavya", "Nitya", "Nivea",
          "नव्या", "दिव्या", "काव्या", "भव्या", "नित्या",
          "ನವ್ಯ", "ದಿವ್ಯ", "ಕಾವ್ಯ", "ಭವ್ಯ", "ನಿತ್ಯ", "ನೀವ್ಯಾರು",
          "నవ్య", "దివ్య", "కావ్య", "భవ్య", "నిత్య"
        ],
        "followUpWindowMs": 20000
      }
    },
    "turn": {
      "strategy": "auto",
      "silenceMs": 350,
      "minSpeechMs": 120,
      "endpointingDelayMs": 0,
      "endpointingMaxDelayMs": 2500,
      "preemptiveGeneration": { "enabled": true, "tts": true },
      "interruption": {
        "enabled": true,
        "localVadEnabled": true,
        "minWords": 0,
        "minDurationMs": 250,
        "falseInterruptionTimeoutMs": 2000,
        "resumeFalseInterruption": true
      }
    },
    "media": {
      "video": {
        "enabled": true,
        "codec": "vp9",
        "backupCodec": "h264",
        "scalabilityMode": "L3T3_KEY",
        "resolution": "h720",
        "maxBitrate": 1700000,
        "maxFramerate": 30,
        "simulcast": true,
        "dynacast": true,
        "adaptiveStream": true
      },
      "audio": {
        "red": true,
        "dtx": true,
        "echoCancellation": true,
        "noiseCancellation": "native"
      },
      "egress": {
        "audioBitrate": 128
      }
    },
    "recording": { "enabled": false },
    "budgets": { "turnGapP50Ms": 800, "turnGapP95Ms": 1500, "bargeInStopP50Ms": 300 }
  },

  "tenants": {
    "t_9c21a4be": {
      "residency": { "allowedRegions": ["ap-south-1"] },
      "budgets": { "maxSessionCostUsd": 2.5 }
    }
  },

  "profiles": {
    "support": {
      "agent": { "personaRef": "persona://support/v3" }
    }
  },

  "languages": {
    "hi": {
      "tuning": {
        "turn": { "strategy": "provider_endpointing", "localVadEnabled": false }
      },
      "overlay": {
        "agent": {
          "pipeline": {
            "stt": {
              "provider": "sarvam",
              "model": "saaras:v3-realtime",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "chunkMs": 500, "encoding": "pcm_s16le", "sampleRate": 16000, "finalGraceMs": 1500 }
            },
            "llm": {
              "provider": "sarvam",
              "model": "sarvam-105b",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "prewarm": true, "thinking": false, "temperature": 0.4, "maxTokens": 200 }
            },
            "tts": {
              "provider": "sarvam",
              "model": "bulbul:v3",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "prewarm": true, "encoding": "pcm_s16le", "sampleRate": 24000, "voice": "priya", "minBufferSize": 30 }
            }
          }
        }
      }
    },

    "en-IN": {
      "tuning": {
        "turn": { "strategy": "semantic", "localVadEnabled": true }
      },
      "overlay": {
        "agent": {
          "pipeline": {
            "stt": {
              "provider": "sarvam",
              "model": "saaras:v3-realtime",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "chunkMs": 500, "encoding": "pcm_s16le", "sampleRate": 16000, "finalGraceMs": 1500 }
            },
            "llm": {
              "provider": "sarvam",
              "model": "sarvam-105b",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "prewarm": true, "thinking": false, "temperature": 0.4, "maxTokens": 200 }
            },
            "tts": {
              "provider": "sarvam",
              "model": "bulbul:v3",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "prewarm": true, "encoding": "pcm_s16le", "sampleRate": 24000, "voice": "priya", "minBufferSize": 30 }
            }
          }
        }
      }
    }
  },

  "channels": {
    "webrtc": {
      "tuning": {
        "turn": { "endpointingDelayMs": 0 }
      },
      "overlay": {
        "media": {
          "egress": {
            "width": 1280,
            "height": 720,
            "framerate": 30,
            "videoBitrate": 3000,
            "videoCodec": "h264_main"
          }
        }
      }
    },

    "telephony": {
      "tuning": {
        "turn": {
          "silenceMs": 900,
          "endpointingDelayMs": 200,
          "interruption": { "minWords": 3 }
        }
      },
      "overlay": {
        "media": {
          "video": { "enabled": false },
          "egress": { "audioBitrate": 64 }
        }
      }
    },

    "long_form": {
      "overlay": {
        "media": {
          "video": {
            "resolution": "h540",
            "maxBitrate": 800000,
            "maxFramerate": 25
          },
          "egress": {
            "width": 1280,
            "height": 720,
            "framerate": 30,
            "videoBitrate": 3000,
            "videoCodec": "h264_main"
          }
        }
      }
    }
  }
}
