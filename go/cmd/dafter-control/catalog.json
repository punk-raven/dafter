          "నవ్య", "దివ్య", "కావ్య", "భవ్య", "నిత్య"
        ],
        "followUpWindowMs": 20000
      },
      "speech": {
        "normalization": "platform",
        "fillers": {
          "enabled": true,
          "afterMs": 600,
          "phrases": {
            "hi": ["हम्म, एक second।", "अच्छा, check करती हूँ।", "हाँ जी, बस एक second।", "जी, देखती हूँ।"],
            "en": ["Hmm, one second.", "Okay, let me check.", "Just a second."],
            "kn": ["ಹಾಂ, ಒಂದ್ second.", "ಸರಿ, check ಮಾಡ್ತೀನಿ.", "ಒಂದ್ ನಿಮಿಷ."],
            "mr": ["हं, एक second.", "थांबा, check करते.", "हो, बघते हं."],
            "te": ["హా, ఒక్క second.", "సరే, check చేస్తా.", "ఒక్క నిమిషం అండి."]
          }
        },
        "situations": {
          "enabled": true,
