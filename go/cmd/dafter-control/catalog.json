{
  "defaults": {
    "apiVersion": "dafter.dev/v1",
    "privacyMode": "open",
    "agent": {
      "enabled": true,
      "pool": "dafter-py",
      "name": "Nivya",
      "greets": false,
      "mode": "cascaded",
      "pipeline": {
        "vad": {
          "provider": "silero",
          "model": "silero",
          "options": { "minSpeechMs": 50, "minSilenceMs": 250, "prefixPaddingMs": 500, "activationThreshold": 0.5 }
        }
      },
      "addressing": {
        "mode": "transcript",
        "aliases": ["निव्या", "ನಿವ್ಯ", "ನಿವ್ಯಾ", "నివ్య", "నివ్యా"],
        "nearMisses": [
