{
  "defaults": {
    "apiVersion": "dafter.dev/v1",
    "privacyMode": "open",
    "agent": {
      "enabled": true,
      "pool": "dafter-py",
      "mode": "cascaded",
      "pipeline": {
        "vad": {
          "provider": "silero",
          "model": "silero",
          "options": { "minSpeechMs": 50, "minSilenceMs": 250, "prefixPaddingMs": 500, "activationThreshold": 0.5 }
        }
      },
      "addressing": {
        "mode": "always",
        "name": "Nivya",
        "aliases": ["निव्या", "ನಿವ್ಯ", "ನಿವ್ಯಾ", "నివ్య", "నివ్యా"],
        "nearMisses": [
          "Navya", "Divya", "Kavya", "Bhavya", "Nitya", "Nivea",
          "नव्या", "दिव्या", "काव्या", "भव्या", "नित्या",
          "ನವ್ಯ", "ದಿವ್ಯ", "ಕಾವ್ಯ", "ಭವ್ಯ", "ನಿತ್ಯ", "ನೀವ್ಯಾರು",
          "నవ్య", "దివ్య", "కావ్య", "భవ్య", "నిత్య"
        ],
        "followUpWindowMs": 20000
      },
      "speech": {
        "normalization": "platform",
        "fillers": {
          "enabled": true,
          "afterMs": 1000,
          "phrases": {
            "hi": ["जी, एक पल।", "अच्छा, ज़रा देखता हूँ।", "हम्म, बस एक सेकंड।"],
            "en": ["One moment.", "Let me check.", "Just a second."],
            "kn": ["ಒಂದು ನಿಮಿಷ.", "ಸ್ವಲ್ಪ ನೋಡುತ್ತೇನೆ."],
            "mr": ["एक क्षण हं.", "थांबा, बघतो."],
            "te": ["ఒక్క నిమిషం.", "చూస్తాను, ఒక్క క్షణం."]
          }
        },
        "situations": {
          "enabled": true,
          "cues": {
            "greeting": {
              "hi": ["नमस्ते", "नमस्कार", "प्रणाम", "हेलो", "हैलो", "namaste", "hello"],
              "en": ["hello", "hi", "hey", "good morning", "good afternoon", "good evening"],
              "kn": ["ನಮಸ್ಕಾರ", "ನಮಸ್ತೆ"],
              "mr": ["नमस्कार", "नमस्ते"],
              "te": ["నమస్కారం", "నమస్తే"]
            },
            "concern": {
              "hi": ["समस्या", "दिक्कत", "परेशानी", "शिकायत", "खराब", "गड़बड़", "नहीं चल रहा", "नहीं हो रहा", "गलत", "नाराज़", "problem", "complaint"],
              "en": ["problem", "issue", "complaint", "not working", "broken", "wrong", "upset", "angry", "refund"],
              "kn": ["ಸಮಸ್ಯೆ", "ತೊಂದರೆ", "ದೂರು", "ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ"],
              "mr": ["समस्या", "अडचण", "तक्रार", "त्रास", "चालत नाही"],
              "te": ["సమస్య", "ఇబ్బంది", "ఫిర్యాదు", "పని చేయడం లేదు"]
            }
          }
        },
        "expressive": false
      }
    },
    "turn": {
      "strategy": "auto",
      "silenceMs": 350,
      "minSpeechMs": 120,
      "endpointingDelayMs": 0,
      "endpointingMaxDelayMs": 2500,
      "preemptiveGeneration": { "enabled": true, "tts": true },
      "interruption": {
        "enabled": true,
        "localVadEnabled": true,
        "minWords": 0,
        "minDurationMs": 250,
        "falseInterruptionTimeoutMs": 2000,
        "resumeFalseInterruption": true,
        "backchannel": {
          "enabled": true,
          "maxWords": 3,
          "answerWithinMs": 1500,
          "words": {
            "hi": ["हाँ", "हां", "हाँजी", "हांजी", "जी", "हम्म", "हम", "हूँ", "हूं", "अच्छा", "ठीक है", "सही", "सही है", "बिल्कुल", "ओके", "haan", "haanji", "ji", "hmm", "achha", "accha", "theek hai", "ok"],
            "en": ["ok", "okay", "hmm", "hm", "mm", "mhm", "uh huh", "yeah", "yes", "yep", "right", "sure", "alright", "got it", "i see"],
            "kn": ["ಹೌದು", "ಹೂಂ", "ಹೂ", "ಹಾಂ", "ಸರಿ", "ಓಕೆ", "ಆಯ್ತು"],
            "mr": ["हो", "हं", "हम्म", "बरं", "ठीक आहे", "ओके", "अच्छा"],
            "te": ["అవును", "ఊ", "ఊం", "హా", "సరే", "ఓకే", "అలాగే"]
          }
        }
      }
    },
    "media": {
      "video": {
        "enabled": true,
        "codec": "vp9",
        "backupCodec": "h264",
        "scalabilityMode": "L3T3_KEY",
        "resolution": "h720",
        "maxBitrate": 1700000,
        "maxFramerate": 30,
        "simulcast": true,
        "dynacast": true,
        "adaptiveStream": true
      },
      "audio": {
        "red": true,
        "dtx": true,
        "echoCancellation": true,
        "noiseCancellation": "native"
      },
      "egress": {
        "audioBitrate": 128
      }
    },
    "recording": { "enabled": false },
    "budgets": { "turnGapP50Ms": 800, "turnGapP95Ms": 1500, "bargeInStopP50Ms": 300 }
  },

  "tenants": {
    "t_9c21a4be": {
      "residency": { "allowedRegions": ["ap-south-1"] },
      "budgets": { "maxSessionCostUsd": 2.5 }
    }
  },

  "profiles": {
    "support": {
      "agent": { "personaRef": "persona://support/v3" }
    }
  },

  "languages": {
    "hi": {
      "tuning": {
        "turn": { "strategy": "provider_endpointing", "localVadEnabled": false }
      },
      "overlay": {
        "agent": {
          "pipeline": {
            "stt": {
              "provider": "sarvam",
              "model": "saaras:v3-realtime",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "chunkMs": 500, "encoding": "pcm_s16le", "sampleRate": 16000, "finalGraceMs": 1500 }
            },
            "llm": {
              "provider": "sarvam",
              "model": "sarvam-105b",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "prewarm": true, "thinking": false, "temperature": 0.4, "maxTokens": 200 }
            },
            "tts": {
              "provider": "sarvam",
              "model": "bulbul:v3",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": {
                "prewarm": true, "encoding": "pcm_s16le", "sampleRate": 24000, "voice": "shubh", "minBufferSize": 30,
                "pace": 1.0, "temperature": 0.6,
                "styles": { "greeting": { "temperature": 0.8 }, "concern": { "pace": 0.9, "temperature": 0.4 } }
              }
            }
          }
        }
      }
    },

    "en-IN": {
      "tuning": {
        "turn": { "strategy": "semantic", "localVadEnabled": true }
      },
      "overlay": {
        "agent": {
          "pipeline": {
            "stt": {
              "provider": "sarvam",
              "model": "saaras:v3-realtime",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "chunkMs": 500, "encoding": "pcm_s16le", "sampleRate": 16000, "finalGraceMs": 1500 }
            },
            "llm": {
              "provider": "sarvam",
              "model": "sarvam-105b",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": { "prewarm": true, "thinking": false, "temperature": 0.4, "maxTokens": 200 }
            },
            "tts": {
              "provider": "sarvam",
              "model": "bulbul:v3",
              "region": "ap-south-1",
              "credentialRef": "secret://tenants/t_9c21a4be/sarvam/api-key",
              "options": {
                "prewarm": true, "encoding": "pcm_s16le", "sampleRate": 24000, "voice": "shubh", "minBufferSize": 30,
                "pace": 1.0, "temperature": 0.6,
                "styles": { "greeting": { "temperature": 0.8 }, "concern": { "pace": 0.9, "temperature": 0.4 } }
              }
            }
          }
        }
      }
    }
  },

  "channels": {
    "webrtc": {
      "tuning": {
        "turn": { "endpointingDelayMs": 0 }
      },
      "overlay": {
        "media": {
          "egress": {
            "width": 1280,
            "height": 720,
            "framerate": 30,
            "videoBitrate": 3000,
            "videoCodec": "h264_main"
          }
        }
      }
    },

    "telephony": {
      "tuning": {
        "turn": {
          "silenceMs": 900,
          "endpointingDelayMs": 200,
          "interruption": { "minWords": 3 }
        }
      },
      "overlay": {
        "media": {
          "video": { "enabled": false },
          "egress": { "audioBitrate": 64 }
        }
      }
    },

    "long_form": {
      "overlay": {
        "media": {
          "video": {
            "resolution": "h540",
            "maxBitrate": 800000,
            "maxFramerate": 25
          },
          "egress": {
            "width": 1280,
            "height": 720,
            "framerate": 30,
            "videoBitrate": 3000,
            "videoCodec": "h264_main"
          }
        }
      }
    }
  }
}
