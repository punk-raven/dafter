  "questions": [
    {
      "id": "hi-01",
      "text": "नमस्ते, आप कैसे हैं?"
    },
    {
      "id": "hi-02",
      "text": "आज का दिन कैसा रहेगा?"
    },
    {
      "id": "hi-03",
      "text": "मुझे चाय बनाने का आसान तरीका बताइए।"
    },
    {
      "id": "hi-04",
      "text": "दिल्ली से मुंबई कितनी दूर है?"
    },
    {
      "id": "hi-05",
      "text": "एक अच्छी किताब का नाम बताइए।"
    },
    {
      "id": "hi-06",
      "text": "मुझे रात को नींद नहीं आती, क्या करूँ?"
    },
    {
      "id": "hi-07",
      "text": "दिन में कितना पानी पीना चाहिए?"
    },
    {
      "id": "hi-08",
      "text": "क्रिकेट के बारे में कुछ बताइए।"
    },
    {
      "id": "hi-09",
      "text": "मेरा फ़ोन बहुत धीमा चल रहा है।"
    },
    {
      "id": "hi-10",
      "text": "बच्चों के लिए कोई अच्छा खेल बताइए।"
    },
    {
      "id": "hi-11",
      "text": "सुबह जल्दी कैसे उठें?"
    },
    {
      "id": "hi-12",
      "text": "अंग्रेज़ी में धन्यवाद कैसे कहते हैं?"
    },
    {
      "id": "hi-13",
      "text": "मुझे एक छोटा सा चुटकुला सुनाइए।"
    },
    {
      "id": "hi-14",
      "text": "बारिश के मौसम में क्या पहनना चाहिए?"
    },
    {
      "id": "hi-15",
      "text": "योग करने के क्या फ़ायदे हैं?"
    },
    {
      "id": "hi-16",
      "text": "मुझे खाना बनाना सीखना है।"
    },
    {
      "id": "hi-17",
      "text": "ट्रेन का टिकट कैसे बुक करें?"
    },
    {
      "id": "hi-18",
      "text": "आपका पसंदीदा रंग कौन सा है?"
    },
    {
      "id": "hi-19",
      "text": "पढ़ाई में मन कैसे लगाएँ?"
    },
    {
      "id": "hi-20",
      "text": "ठीक है, बहुत बहुत धन्यवाद।"
    },
    {
      "id": "hi-21",
      "text": "दिल्ली में आज मौसम कैसा है?",
