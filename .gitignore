/go/bin/
*.test
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.mypy_cache/

# Docker compose runtime (SQLite store plus its WAL and shared-memory sidecars)
dafter.db*

# Build and profiling output
coverage.out
*.prof
dist/
build/

# Generated from schemas/ by `make generate`
/go/internal/**/*_gen.go
/go/internal/schema/schemas/
/python/dafter_core/src/dafter_core/_schemas/
/python/dafter_core/src/dafter_core/enums.py

# Media load test output (scripts/loadtest-media.sh)
.loadtest-media/
