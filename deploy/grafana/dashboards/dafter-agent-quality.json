{
  "uid": "dafter-agent-quality",
  "title": "Dafter agent quality",
  "description": "How the agent's production replies score with the scribe's judge (the dafter-screen criteria) on the sampled turns, by language, config version, canary arm and criterion. Scraped from the scribe worker (DAFTER_METRICS_PORT, job dafter-scribe).",
  "tags": ["dafter"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m"]},
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [
    {
      "title": "Dafter",
      "type": "dashboards",
      "tags": ["dafter"],
      "asDropdown": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Turns scored (1 h)",
      "description": "Agent turns the scribe's judge scored in the last hour.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "-",
          "thresholds": {"mode": "absolute", "steps": [{"color": "#5794F2", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(dafter_scribe_turns_total{outcome=\"scored\"}[1h]))",
          "legendFormat": "Turns scored (1 h)",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pass share (1 h)",
      "description": "Share of all criterion verdicts in the last hour that were pass.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "-",
          "thresholds": {"mode": "absolute", "steps": [{"color": "#5794F2", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(dafter_scribe_verdicts_total{verdict=\"pass\"}[1h])) / (sum(increase(dafter_scribe_verdicts_total[1h])) > 0)",
          "legendFormat": "Pass share (1 h)",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mean turn score (1 h)",
      "description": "Mean over the scored turns of the last hour: pass 1, maybe 0.5, fail 0.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "-",
          "thresholds": {"mode": "absolute", "steps": [{"color": "#5794F2", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(dafter_scribe_turn_score_sum[1h])) / (sum(increase(dafter_scribe_turn_score_count[1h])) > 0)",
          "legendFormat": "Mean turn score (1 h)",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kept for review (1 h)",
      "description": "Scored turns with a fail verdict written to the review queue in the last hour.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "-",
          "thresholds": {"mode": "absolute", "steps": [{"color": "#5794F2", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(dafter_scribe_turns_total{outcome=\"kept_for_review\"}[1h]))",
          "legendFormat": "Kept for review (1 h)",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pass share by language and criterion (1 h)",
      "description": "Share of each criterion's verdicts that were pass, per session language.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "mean"]
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (language, criterion) (increase(dafter_scribe_verdicts_total{verdict=\"pass\"}[1h])) / (sum by (language, criterion) (increase(dafter_scribe_verdicts_total[1h])) > 0)",
          "legendFormat": "{{language}} {{criterion}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fail share by version and arm (1 h)",
      "description": "Share of each criterion's verdicts that were fail, per config version and canary arm: compare a candidate against its stable arm here.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "mean"]
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (version, arm, criterion) (increase(dafter_scribe_verdicts_total{verdict=\"fail\"}[1h])) / (sum by (version, arm, criterion) (increase(dafter_scribe_verdicts_total[1h])) > 0)",
          "legendFormat": "{{version}} {{arm}} {{criterion}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Mean turn score by language and version (1 h)",
      "description": "Mean scored-turn score per session language, config version and arm.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "mean"]
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (language, version, arm) (increase(dafter_scribe_turn_score_sum[1h])) / (sum by (language, version, arm) (increase(dafter_scribe_turn_score_count[1h])) > 0)",
          "legendFormat": "{{language}} {{version}} {{arm}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Turns per hour by outcome",
      "description": "What became of the agent turns the scribe saw, at the rate of the last 5 min: scored, unsampled, capped by maxTurnsPerSession, dropped, errored, kept_for_review.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "mean"]
        },
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (outcome) (rate(dafter_scribe_turns_total[5m])) * 3600",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "range": true
        }
      ]
    }
  ]
}
